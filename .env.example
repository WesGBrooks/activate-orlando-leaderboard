# Activate public site
ACTIVATE_BASE_URL=https://playactivate.com
ACTIVATE_LOCATION_ID=42
ACTIVATE_LOCATION_SLUG=pointe-orlando
ACTIVATE_LOCATION_NAME=Orlando (Pointe Orlando)

# Cache TTL for fetched player pages (seconds). Keep polite: 5–15 minutes.
CACHE_TTL_SECONDS=600

# Paths (Railway: use a volume mounted at /app/data if you want persistence)
FRIENDS_PATH=data/friends.json
CACHE_DB_PATH=data/cache.sqlite3

# Identifying User-Agent for polite fetches
HTTP_USER_AGENT=activate-orlando-leaderboard/0.1 (+https://github.com/WesGBrooks/activate-orlando-leaderboard)

# When Activate is unreachable (Cloudflare, etc.), serve fixture demo data
DEMO_MODE_FALLBACK=true
FORCE_DEMO_MODE=false

# Optional: paste a browser Cookie header if your deploy IP is challenged by Cloudflare
# ACTIVATE_COOKIE=XSRF-TOKEN=...; playactivate_session=...; cf_clearance=...

# Optional: require this token for add/remove/refresh form posts
# ADMIN_TOKEN=change-me

PORT=8000
HOST=0.0.0.0
